# Pi packages bundled by this preset routinely declare peer ranges on Pi core packages
# (see README "依赖约定") that the Pi runtime — not this repo — provides at runtime.
# npm's strict peer resolution refuses to install some of them, e.g. several
# bundled packages pin @earendil-works/pi-tui ">=0.74.0 <0.80.0" while this
# preset tracks the current Pi release line (0.85.x). `force` tolerates those conflicts while
# still installing the peer tree itself (unlike legacy-peer-deps, which drops it).
force=true
